# App URLs
# For local dev, set to http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Supabase (Project_Spore us-east-1)
# Find these in Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (DO NOT set on Vercel client envs)
# Use in GitHub Actions or local dev server for admin operations (e.g., /api/waitlist)
SUPABASE_SERVICE_ROLE=

# Telemetry (optional)
SENTRY_DSN=

# Auth redirect(s) (comma-separated), e.g. https://project-spore.vercel.app
AUTH_REDIRECT_URLS=
