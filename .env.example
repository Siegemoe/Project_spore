# Database
# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/spore"

# App URLs
# For local dev, set to http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Supabase (Project_Spore us-east-1)
# Find these in Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (DO NOT set on Vercel client envs)
# Use in GitHub Actions or local dev server for admin operations (e.g., /api/waitlist)
SUPABASE_SERVICE_ROLE=

# Upstash Redis (for rate limiting)
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telemetry (optional)
SENTRY_DSN=

# Feature flags
# Toggle the new mobile-first UI chrome (TopBar + MobileTabBar + Composer sheet)
# true = enable new experience, false = keep legacy layout header/footer
NEXT_PUBLIC_NEW_MOBILE_UI=true

# Enable admin dashboard and admin API routes
NEXT_PUBLIC_ENABLE_ADMIN=false
